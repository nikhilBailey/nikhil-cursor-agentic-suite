.DS_Store
__pycache__/
*.pyc
*.pyo

# Workplace-specific skills stay local. Track only .gitkeep so employer
# folders exist in git; add another folder + .gitkeep for a future job.
workplace-specific/**
!workplace-specific/**/
!workplace-specific/**/.gitkeep

# Hook runtime (approved-libraries.json and similar)
hooks/state/

# Never store live MCP credentials. Use mcp.json.example instead.
mcp.json
*.local
.env
.env.*
